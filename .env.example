# Environment Variables — nailsweb
# העתק קובץ זה ל-.env.local ומלא את הערכים
# קבל ערכים מגל — אין לשתף ערכים אלה בשום מקום ציבורי

# ─── Supabase ───────────────────────────────────────────────
# כתובת פרויקט Supabase (Frankfurt EU)
VITE_SUPABASE_URL=

# מפתח anon ציבורי — נטען בclient side
VITE_SUPABASE_KEY=

# מפתח anon (גרסה חלופית — ייתכן שנדרש לclient)
VITE_SUPABASE_ANON_KEY=

# מפתח service_role — חובה לAPI routes (push, receipts, RLS bypass)
# אסור לחשוף ל-client side
SUPABASE_SERVICE_KEY=

# ─── Twilio (SMS / OTP) ─────────────────────────────────────
# Account SID מדשבורד Twilio
TWILIO_ACCOUNT_SID=

# Auth Token מדשבורד Twilio
TWILIO_AUTH_TOKEN=

# מספר הטלפון השולח — פורמט +19896253806
TWILIO_PHONE=

# מספר הטלפון של בעלת הסטודיו לקבלת התראות SMS
OWNER_PHONE=

# ─── Resend (Email Receipts) ────────────────────────────────
# API Key מדשבורד Resend — domain: rise-booking.com
RESEND_API_KEY=

# ─── Web Push / VAPID ───────────────────────────────────────
# מפתח VAPID ציבורי — נטען בclient side
VAPID_PUBLIC_KEY=

# מפתח VAPID פרטי — בserver side בלבד
VAPID_PRIVATE_KEY=

# כתובת מייל לnotifications (פורמט: mailto:email@example.com)
VAPID_SUBJECT=

# ─── Feature Flags ──────────────────────────────────────────
# חנות מוצרים
VITE_FEATURE_STORE=

# תשלומים אונליין (כרגע false — לא בנוי)
VITE_FEATURE_PAYMENTS=

# ניהול צוות
VITE_FEATURE_STAFF=

# דוחות
VITE_FEATURE_REPORTS=

# ביקורות לקוחות
VITE_FEATURE_REVIEWS=

# גלריה תמונות
VITE_FEATURE_GALLERY=

# רשימת המתנה
VITE_FEATURE_WAITLIST=
